#!/bin/bash
# Minimize tile with layout awareness:
#   filmstrip (scrolling) → do nothing
#   tilekeeper → minimize
#   dwindle → switch to tilekeeper, then minimize
WORKSPACE=$(hyprctl activeworkspace -j | jq -r '.id')
LAYOUT=$(hyprctl activeworkspace -j | jq -r '.tiledLayout')

case "$LAYOUT" in
  scrolling)
    hyprctl notify -g "Filmstrip mode — minimize disabled" 2>/dev/null
    ;;
  tilekeeper)
    hyprctl eval "hl.plugin.tilekeeper.minimize()"
    ;;
  dwindle)
    hyprctl eval "hl.workspace_rule({ workspace = \"$WORKSPACE\", layout = \"tilekeeper\" }); hl.plugin.tilekeeper.minimize()"
    ;;
esac
